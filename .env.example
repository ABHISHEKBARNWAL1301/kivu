# Optional. Copy to .env to change where kivu keeps its data. .env is gitignored.
# Without KIVU_DATABASE_URL, kivu uses SQLite at ~/.config/kivu/kivu.db.

# To use Postgres instead: `docker compose up -d`, then uncomment the URL.
POSTGRES_USER=kivu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kivu
POSTGRES_PORT=5433
# KIVU_DATABASE_URL=postgresql+psycopg://kivu:change-me@127.0.0.1:5433/kivu
